{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskpilot.example/contracts/audio-extraction-requested.schema.json",
  "title": "Audio Extraction Requested",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "requestId", "occurredAt", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "audio.extraction.requested" },
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoId", "startSeconds", "endSeconds", "outputFormat"],
      "properties": {
        "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
        "startSeconds": { "type": "integer", "minimum": 0 },
        "endSeconds": { "type": "integer", "minimum": 1 },
        "outputFormat": { "const": "mp3" }
      }
    }
  }
}
