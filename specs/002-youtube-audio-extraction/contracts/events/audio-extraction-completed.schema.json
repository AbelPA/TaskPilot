{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskpilot.example/contracts/audio-extraction-completed.schema.json",
  "title": "Audio Extraction Completed",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "requestId", "occurredAt", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "audio.extraction.completed" },
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectKey", "contentType", "durationSeconds", "sizeBytes", "checksumSha256"],
      "properties": {
        "objectKey": { "type": "string", "minLength": 1, "maxLength": 512 },
        "contentType": { "const": "audio/mpeg" },
        "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "checksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
