# Local development only. Do not reuse these credentials outside this machine.
# Copy to .env for local Compose use; never commit .env.

# PostgreSQL: available to containers at postgres:5432.
POSTGRES_DB=taskpilot
POSTGRES_USER=taskpilot
POSTGRES_PASSWORD=taskpilot-local-postgres

# RabbitMQ: containers use rabbitmq:5672; management UI is published on localhost:15672.
RABBITMQ_USER=taskpilot
RABBITMQ_PASSWORD=taskpilot-local-rabbitmq

# SeaweedFS S3: containers use seaweedfs:8333; from the host use localhost:8333.
# Filer console is published on localhost:8888.
S3_ACCESS_KEY=taskpilot
S3_SECRET_KEY=taskpilot-local-s3-secret
S3_BUCKET=audio-extractions
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333

# The web container proxies /api to api:8080. The web UI is published on localhost:4200.
# This URL is for running the web app directly with the development server.
API_BASE_URL=http://localhost:5290

# Local PostHog Compose stack. Create a project and copy its project token from PostHog.
# Leave the token empty to disable browser capture until the project is configured.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=http://localhost:8000

# SETTINGS_ENCRYPTION_KEY (base64, 256 bits) encrypts secrets saved on the Settings
# screen. scripts/start-local.sh generates it in .env; losing it makes saved secrets
# unreadable. Generate one manually with: openssl rand -base64 32
# The YouTube Data API key is configured on the Settings screen (/settings) and stored
# encrypted in the database.

# INTERNAL_API_TOKEN lets the audio worker read the YouTube account saved on the Settings
# screen. scripts/start-local.sh generates it in .env. Generate one manually with:
# openssl rand -hex 32
