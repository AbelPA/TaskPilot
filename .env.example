# Copy to .env for local Compose use. Replace placeholders locally; never commit .env.
YOUTUBE_DATA_API_KEY=replace-with-a-youtube-data-api-key

POSTGRES_DB=taskpilot
POSTGRES_USER=taskpilot
POSTGRES_PASSWORD=replace-local-postgres-password

RABBITMQ_USER=taskpilot
RABBITMQ_PASSWORD=replace-local-rabbitmq-password

S3_ACCESS_KEY=taskpilot
S3_SECRET_KEY=replace-local-s3-password
S3_BUCKET=audio-extractions
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333

# The web container proxies /api to the API service. This URL is for direct development.
API_BASE_URL=http://localhost:5290
