{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AudioExtraction": {
    "MaximumIntervalSeconds": 1800,
    "MaximumSourceDurationSeconds": 21600,
    "RequestsPerMinutePerIp": 5,
    "MaximumDownloadBytes": 2147483648,
    "MaximumOutputBytes": 104857600,
    "WorkerTimeoutMinutes": 15,
    "RetentionDays": 7,
    "ApplyMigrationsOnStartup": true
  },
  "AllowedHosts": "*"
}
